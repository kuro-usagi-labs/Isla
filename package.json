{
  "name": "isla-music-player",
  "private": true,
  "version": "1.0.5",
  "description": "Isla — a fluid, floating offline music player",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1425 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1426",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:input-routing": "node scripts/test-input-routing.mjs",
    "test:input-native": "node scripts/test-native-input.mjs",
    "tauri": "tauri",
    "showcase:build": "node scripts/build-showcase.mjs",
    "showcase:preview": "hyperframes preview media/showcase",
    "showcase:check": "hyperframes check media/showcase",
    "showcase:render": "node scripts/render-launch.mjs media/showcase/index.html media/renders/isla-launch-1080p60.mp4 60 2 4 2",
    "showcase:draft": "node scripts/render-launch.mjs media/showcase/index.html media/renders/isla-launch-draft.mp4 30 1 4 1",
    "showcase:package": "node scripts/package-showcase.mjs",
    "showcase:render:hyperframes": "hyperframes render media/showcase -o media/renders/isla-showcase-hyperframes.mp4 --fps 60 --quality high --workers 2"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.22",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@fontsource/inter": "^5.3.0",
    "@tailwindcss/vite": "^4.1.13",
    "@tauri-apps/cli": "^2.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "gsap": "^3.15.1",
    "hyperframes": "^0.9.30",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@12.18.0"
}
